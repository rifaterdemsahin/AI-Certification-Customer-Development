# .env.example - Local environment variables template
# NOTE: Real secrets are never committed to git. Load them at runtime via the
# existing shared Azure Key Vault — do not provision a new vault for this project.

# --- AZURE KEY VAULT CONFIGURATION ---
AZURE_KEYVAULT_NAME="dp-kv-deliverypilot"
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_CLIENT_ID="your-service-principal-client-id"
AZURE_CLIENT_SECRET="your-service-principal-client-secret"

# --- AI/LLM PROVIDER (PULLED FROM KEY VAULT AT RUNTIME) ---
# az keyvault secret show --vault-name dp-kv-deliverypilot --name ANTHROPIC-API-KEY
ANTHROPIC_API_KEY="your-api-key-here"

# --- AXIOM (SERVER-SIDE LOGS, IF USED) ---
# az keyvault secret show --vault-name dp-kv-deliverypilot --name AXIOM-TOKEN
AXIOM_TOKEN="xaat-your-axiom-api-token"
AXIOM_DATASET="ai-certification-customer-development"

# --- YOUTUBE (VIDEO PIPELINE) ---
# az keyvault secret show --vault-name dp-kv-deliverypilot --name YOUTUBE-API-KEY
YOUTUBE_API_KEY="your-youtube-data-api-key"
YOUTUBE_CLIENT_SECRET="your-youtube-oauth-client-secret"
YOUTUBE_TOKEN="your-youtube-oauth-token"

# --- CANVA MCP (DESIGN ASSET PIPELINE) ---
# az keyvault secret show --vault-name dp-kv-deliverypilot --name canva-mcp-CANVA-CLIENT-ID
CANVA_CLIENT_ID="your-canva-client-id"
CANVA_CLIENT_SECRET="your-canva-client-secret"

# This project is a static HTML/CSS/JS site with no build step and no
# database/container backend — Supabase, Fly.io, Cloudflare Workers, and
# Ollama/Qdrant variables from the upstream template do not apply here and
# have been intentionally omitted.
